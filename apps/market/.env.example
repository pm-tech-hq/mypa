# Copy to .env.local (or run `vercel env pull apps/market/.env.local`).
# Never commit real values.

# Neon Postgres (Vercel Marketplace integration)
DATABASE_URL=

# Vercel Blob store for uploaded widget bundles
BLOB_READ_WRITE_TOKEN=

# Auth.js + GitHub OAuth app (callback: <site>/api/auth/callback/github)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed into /admin
ADMIN_GITHUB_LOGINS=

# Stripe (Connect) — test keys for development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=15

# ed25519 private key (PEM, base64-encoded) that signs /registry.json
MARKETPLACE_SIGNING_KEY=
# 32-byte key (base64) that encrypts publishers' license-signing keys at rest
LICENSE_ENCRYPTION_KEY=

# Public URL of the site (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
