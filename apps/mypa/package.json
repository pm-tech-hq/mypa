{
  "name": "mypa",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "myPA — a personal-assistant desktop app. A blank board you fill with resizable widgets.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir",
    "widgets:build": "node ../../packages/widget-sdk/bin/mypa-widget.ts registry --src widgets --out resources/registry --key .keys/registry-root.pem --name \"myPA Official\" --publishers widgets/publishers.json"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "@repo/design-system": "workspace:*",
    "@repo/widget-sdk": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^24.1.3",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.45.0",
    "node-ical": "^0.27.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "sql.js": "^1.12.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "7.0.2",
    "vite": "^5.4.11"
  }
}
